# Copy to .env.local (never commit .env.local) and fill in real values.

# --- Firebase Web App config (from Firebase Console > Project settings > Your apps > Web app) ---
# Public by design — these identify the project, they are not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Shop ---
# Any short slug identifying this shop's documents. One shop per deployment in v1.
NEXT_PUBLIC_SHOP_ID=default-shop

# --- Firebase Admin SDK (server-only) ---
# From Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the JSON's fields below. Keep the surrounding quotes on the private key and its \n's.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Seed script (scripts/seed.ts) ---
# Creates the first Admin login. Only needed to run `npm run seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
