# Copy to .env.local (never commit .env.local) and fill in real values.

# --- Firebase Web App config (from Firebase Console > Project settings > Your apps > Web app) ---
# Public by design — these identify the project, they are not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Shop ---
# Any short slug identifying this shop's documents. One shop per deployment in v1.
NEXT_PUBLIC_SHOP_ID=default-shop

# --- SaaS multi-tenancy (Phase 2) ---
# Your own custom domain once registered and added to Vercel (as both the domain itself and a
# wildcard *.yourdomain.com) — e.g. "yourdomain.com". Leave blank until then: every request is
# treated as the single-shop root domain (today's behavior) when this is unset. See
# src/proxy.ts + src/lib/shop/hostname.ts.
NEXT_PUBLIC_APP_DOMAIN=

# Shared secret for the /superadmin console (shop-signup review/approval). Generate the same way
# as PIN_PEPPER below, and keep it private — anyone with this key can approve/reject shop signups.
SUPERADMIN_ACCESS_KEY=

# --- Billing (SaaS Phase 3 — Omise recurring subscription charges) ---
# From your Omise dashboard (https://dashboard.omise.co) — test-mode keys (skey_test_.../
# pkey_test_...) work immediately with no approval wait, and Omise publishes test card numbers
# for exercising both the success and decline paths without spending real money.
NEXT_PUBLIC_OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when it calls
# /api/cron/billing daily. Generate the same way as PIN_PEPPER below.
CRON_SECRET=

# --- Firebase Admin SDK (server-only) ---
# From Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the JSON's fields below. Keep the surrounding quotes on the private key and its \n's.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- PIN login (server-only secret) ---
# Secret key used to hash staff PINs. NEVER commit this and never change it after go-live:
# rotating it invalidates every existing PIN.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_PEPPER=

# --- Seed script (scripts/seed.ts) ---
# Creates the first Admin login. Only needed to run `npm run seed`.
# SEED_ADMIN_PIN must be exactly 6 digits — this is what you type on the login keypad.
SEED_ADMIN_PIN=
SEED_ADMIN_NAME=Admin
